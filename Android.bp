// SPDX-License-Identifier: Apache-2.0
package {
    default_applicable_licenses: ["AccessCard_license"],
}

license {
    name: "AccessCard_license",
    visibility: [":__subpackages__"],
    license_kinds: ["SPDX-license-identifier-Apache-2.0"],
    license_text: ["LICENSE"],
}

filegroup {
    name: "accesscard-core-sources",
    srcs: ["src/**/model/*.java", "src/**/data/*.java"],
}

filegroup {
    name: "accesscard-domain-sources",
    srcs: ["src/**/domain/*.kt", "src/**/nfc/AccessCardContract.kt"],
}

java_defaults {
    name: "accesscard-compose-defaults",
    kotlincflags: ["-Xjvm-default=all"],
    static_libs: [
        "androidx.activity_activity-compose",
        "androidx.compose.animation_animation",
        "androidx.compose.foundation_foundation",
        "androidx.compose.foundation_foundation-layout",
        "androidx.compose.material3_material3",
        "androidx.compose.runtime_runtime",
        "androidx.compose.runtime_runtime-saveable",
        "androidx.compose.ui_ui",
        "androidx.compose.ui_ui-tooling-preview",
        "androidx.lifecycle_lifecycle-viewmodel-compose",
        "androidx.lifecycle_lifecycle-runtime-ktx",
        "kotlinx_coroutines",
    ],
}

// The production wallet components are also used by the standalone UI test APK.
android_library {
    name: "AccessCardUi",
    defaults: ["accesscard-compose-defaults"],
    srcs: [
        "src/**/ui/*.kt",
        "src/**/model/*.java",
        "src/**/domain/WalletState.kt",
        "src/**/nfc/AccessCardContract.kt",
    ],
    manifest: "AndroidManifest-ui.xml",
    resource_dirs: ["res"],
    platform_apis: true,
}

android_app {
    name: "AccessCard",
    defaults: ["accesscard-compose-defaults"],
    srcs: ["src/**/*.kt", "src/**/*.java"],
    exclude_srcs: [
        "src/**/ui/*.kt",
        "src/**/model/*.java",
        "src/**/domain/WalletState.kt",
        "src/**/nfc/AccessCardContract.kt",
    ],
    resource_dirs: [],
    manifest: "AndroidManifest.xml",
    platform_apis: true,
    certificate: "platform",
    system_ext_specific: true,
    privileged: true,
    privapp_allowlist: "privapp-permissions-org.derpfest.accesscard.xml",
    optimize: { enabled: false },
    static_libs: ["AccessCardUi"],
}
